# Kernel configuration: CONFIG_XNU_<NAME> becomes XNU_<NAME> for the kernel build script.
# MSM8953 / Snapdragon 632 (Redmi 7 / onclite): ARMv8-A, DT platform, ARM CPU.
# Redmi 7 uses eMMC storage, not UFS.
# No native Adreno GPU driver selected yet for Adreno 506.
CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
